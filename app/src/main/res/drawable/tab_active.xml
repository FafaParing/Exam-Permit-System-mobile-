<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color (light blue tint) -->
    <solid android:color="#1A003E7A"/>

    <!-- Rounded corners -->
    <corners android:radius="20dp"/>

    <!-- Padding effect -->
    <padding
        android:left="12dp"
        android:top="6dp"
        android:right="12dp"
        android:bottom="6dp"/>

    <!-- Optional border -->
    <stroke
        android:width="1dp"
        android:color="#003E7A"/>
</shape>